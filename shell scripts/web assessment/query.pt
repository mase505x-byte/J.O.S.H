<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Authorized Website Target</title>
	<style>
		body { max-width: 42rem; margin: 3rem auto; padding: 0 1rem; font: 1rem/1.5 system-ui, sans-serif; color: #17202a; }
		label { display: block; margin: 1rem 0 .4rem; font-weight: 600; }
		input, button { box-sizing: border-box; padding: .7rem; font: inherit; }
		input { width: 100%; }
		button { margin-top: 1rem; cursor: pointer; }
		#status { margin-top: 1rem; overflow-wrap: anywhere; }
		#status[data-state="error"] { color: #a11; }
		#status[data-state="success"] { color: #176b35; }
	</style>
</head>
<body>
	<main>
		<h1>Website Assessment Target</h1>
		<p>Submit a domain or HTTP(S) URL that you are authorized to assess.</p>
		<form id="target-form">
			<label for="target">Domain or URL</label>
			<input id="target" name="target" type="text" placeholder="example.com or https://example.com" required autocomplete="url" spellcheck="false">
			<button type="submit">Submit target</button>
		</form>
		<p id="status" role="status" aria-live="polite"></p>
		<pre id="target-data" hidden></pre>
	</main>
	<script>
		const form = document.querySelector('#target-form');
		const input = document.querySelector('#target');
		const status = document.querySelector('#status');
		const targetData = document.querySelector('#target-data');

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const value = input.value.trim();
			const candidate = /^[a-z][a-z\d+.-]*:\/\//i.test(value) ? value : `https://${value}`;

			try {
				const url = new URL(candidate);
				if (!['http:', 'https:'].includes(url.protocol) || !url.hostname || url.username || url.password) {
					throw new Error('Invalid target');
				}

				const target = {
					url: url.href,
					hostname: url.hostname,
					protocol: url.protocol.slice(0, -1)
				};
				status.dataset.state = 'success';
				status.textContent = `Target ready: ${target.hostname}`;
				targetData.hidden = false;
				targetData.textContent = JSON.stringify(target, null, 2);

				// The scanner/AI can listen for this event to receive normalized input.
				window.dispatchEvent(new CustomEvent('assessment-target-submitted', { detail: target }));
			} catch {
				status.dataset.state = 'error';
				status.textContent = 'Enter a valid domain or HTTP(S) URL without login credentials.';
				targetData.hidden = true;
				targetData.textContent = '';
			}
		});
	</script>
</body>
</html>
